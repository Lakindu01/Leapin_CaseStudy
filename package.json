{
  "name": "leapin_casestudy",
  "version": "1.0.0",
  "description": "The service manages:",
  "type": "module",
  "scripts": {
    "analyse": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "start:offline": "npm run build && osls offline --noPrependStageInUrl --param=\"DB_PASSWORD=rootpassword\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "vitest run --project integration",
    "deploy:aws": "osls deploy --stage prod",
    "smoke:aws": "tsx scripts/smoke.ts",
    "remove:aws": "osls remove --stage prod",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lakindu01/Leapin_CaseStudy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Lakindu01/Leapin_CaseStudy/issues"
  },
  "homepage": "https://github.com/Lakindu01/Leapin_CaseStudy#readme",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/supertest": "^6.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^2.0.0",
    "osls": "github:oss-serverless/serverless",
    "serverless-offline": "^14.7.2",
    "supertest": "^7.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1068.0",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "mysql2": "^3.22.5",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "serverless-http": "^4.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.0"
  }
}
